# ==========================================================
# Aura AI Personal Assistant - Environment Configuration
# ==========================================================

# Active LLM Provider: "groq", "gemini", "openrouter", or "ollama"
# Default is Groq (100% Free, instant, zero-setup for all visitors)
DEFAULT_PROVIDER=groq

# ----------------------------------------------------------
# 100% FREE LLM API KEYS (Zero Credit Card Required!)
# ----------------------------------------------------------
# 1. Groq Cloud (Default Free Public Engine, get free key: https://console.groq.com/keys)
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=groq/compound-mini

# 2. Google Gemini API (Free Tier from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# 3. OpenRouter (Multi-model free tier, get free key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
DEFAULT_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ----------------------------------------------------------
# Supabase Cloud Authentication (Optional for deployment sync)
# ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------
# Ollama Local Endpoint (100% Free, Offline, Zero API Key)
# ----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ----------------------------------------------------------
# Assistant Settings
# ----------------------------------------------------------
ASSISTANT_NAME=Aura
USER_NAME=Faizan
MAX_SHORT_TERM_MESSAGES=20
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
