# ==========================================================
# Aura AI Personal Assistant - Environment Configuration
# ==========================================================

# Active LLM Provider: "openrouter", "gemini", "groq", "openai", or "ollama"
DEFAULT_PROVIDER=openrouter

# ----------------------------------------------------------
# 100% FREE LLM API KEYS (No credit card needed!)
# ----------------------------------------------------------
# 1. OpenRouter (Get free key at: https://openrouter.ai/keys)
# Free models: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free, google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=
DEFAULT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 2. Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash-lite

# 3. Groq API (Ultra-fast Llama-3, get free key at: https://console.groq.com/keys)
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------
# Optional / Other Providers
# ----------------------------------------------------------
# 3. OpenAI API Key
OPENAI_API_KEY=

# 4. Ollama Local Endpoint (100% Free, Offline, Zero API Key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ----------------------------------------------------------
# Assistant Settings
# ----------------------------------------------------------
ASSISTANT_NAME=Aura
USER_NAME=User
MAX_SHORT_TERM_MESSAGES=20
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
